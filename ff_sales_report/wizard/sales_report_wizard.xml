<?xml version="1.0" ?>
<odoo>
    <record id="custom_sales_report_wizard_form" model="ir.ui.view">
        <field name="name">Sales Report</field>
        <field name="model">custom.sales.report</field>
        <field name="arch" type="xml">
            <form string="Sales Wizard">
                <group>
                    <group>
                        <field name="custom" widget="radio" />
                        <field
              name="monthly"
              invisible="custom != 'monthly'"
            />
                    </group>
                    <group>
                        <field
              name="yearly"
              attrs="{'invisible': [('custom','!=','yearly')]}"
              invisible="custom != 'yearly'"
            />
                        <field
              name="start_date"
              invisible="custom != 'custom'"
            />
                        <field
              name="end_date"
              invisible="custom != 'custom'"
            />
                    </group>
                </group>

                <footer>
                    <button
            name="generate_report"
            string="Generate"
            type="object"
            class="oe_highlight"
          />
                    <button string="Cancel" class="btn-secondary" special="cancel" />
                </footer>
            </form>
        </field>
    </record>

    <record id="custom_sales_report_wiz_action" model="ir.actions.act_window">
        <field name="name">Sales Report</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">custom.sales.report</field>
        <field name="view_mode">form</field>
        <field name="view_id" ref="custom_sales_report_wizard_form" />
        <field name="target">new</field>
    </record>

    <menuitem
    id="parent_sales_report_id"
    name="Sales Report"
    parent="sale.menu_sale_report"
    sequence="5"
  />
    <menuitem
    id="child_sales_report_id"
    name="Sales Report"
    parent="parent_sales_report_id"
    sequence="0"
    action="custom_sales_report_wiz_action"
  />

</odoo>
